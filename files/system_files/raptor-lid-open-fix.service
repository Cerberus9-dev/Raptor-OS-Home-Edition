[Unit]
Description=Raptor OS -- re-scan input devices after resume
After=suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target

[Service]
Type=oneshot
# Touchpad re-initialisation itself is done by the systemd-sleep hook
# /usr/lib/systemd/system-sleep/raptor-resume (see raptor-hardware-fixes.sh).
# This unit only asks udev to re-announce input devices so libinput/KWin
# pick up anything that re-enumerated. (The old KWin "reloadConfig" call was
# removed: a system service runs as root and cannot reach the user's session
# bus, so it always failed.)
ExecStart=/bin/sleep 2
ExecStart=-/bin/udevadm trigger --subsystem-match=input --action=change
ExecStart=-/bin/udevadm settle --timeout=5

[Install]
WantedBy=suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target
