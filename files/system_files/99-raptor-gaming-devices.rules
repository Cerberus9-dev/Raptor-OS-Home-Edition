# Gaming device udev rules - auto-applied at build time

# Logitech
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="046d", MODE="0660", GROUP="input", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="046d", MODE="0660", GROUP="input", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c52b", MODE="0660", GROUP="input", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c539", MODE="0660", GROUP="input", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="046d", ATTRS{idProduct}=="c548", MODE="0660", GROUP="input", TAG+="uaccess"

# Razer
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1532", MODE="0660", GROUP="input", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="1532", MODE="0660", GROUP="input", TAG+="uaccess"

# SteelSeries
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1038", MODE="0660", GROUP="input", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="1038", MODE="0660", GROUP="input", TAG+="uaccess"

# Corsair
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1b1c", MODE="0660", GROUP="input", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="1b1c", MODE="0660", GROUP="input", TAG+="uaccess"

# HyperX
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0951", MODE="0660", GROUP="input", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="0951", MODE="0660", GROUP="input", TAG+="uaccess"

# Glorious
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="3434", MODE="0660", GROUP="input", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="3434", MODE="0660", GROUP="input", TAG+="uaccess"

# Roccat
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1e7d", MODE="0660", GROUP="input", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="1e7d", MODE="0660", GROUP="input", TAG+="uaccess"

# Turtle Beach
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="24f0", MODE="0660", GROUP="input", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="24f0", MODE="0660", GROUP="input", TAG+="uaccess"

# Generic HID gaming devices
SUBSYSTEM=="hidraw", KERNEL=="hidraw*", MODE="0660", GROUP="input", TAG+="uaccess"

# Joystick / gamepad support
KERNEL=="js[0-9]*", MODE="0660", GROUP="input", TAG+="uaccess"
KERNEL=="event[0-9]*", SUBSYSTEM=="input", MODE="0660", GROUP="input", TAG+="uaccess"
