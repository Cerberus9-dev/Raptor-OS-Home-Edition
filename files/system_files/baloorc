[Basic Settings]
# Raptor OS — Baloo (file indexer) stability defaults.
# Baloo's content indexer digs INTO file contents by default. On bulk
# operations (selecting many files, right-click -> delete, opening the
# context menu) KFileMetaData asks Baloo for metadata per file, and for
# archives, videos and huge documents that means reading the file again —
# the UI wedges ("freeze when selecting a zip", "freeze when right-clicking
# a big selection to delete"). These keys stop content indexing entirely
# and clamp how large a file Baloo will touch; tags/ratings still work.
IndexFileContent=false
IndexFileSizeLimit=4
IndexVideoSizeLimit=8
IndexImageSizeLimit=4

[General]
# Never index archive contents at all — just listing that a .zip exists in
# the file tree is enough. Baloo skips these globs everywhere, so selecting
# or context-menu-ing a big .zip/.tar.gz can't trigger an archive read.
exclude filters=*.zip *.tar *.gz *.tgz *.tar.gz *.bz2 *.tbz2 *.tar.bz2 *.7z *.rar *.xz *.lzma *.lz *.zst *.iso *.img *.dmg *.cab *.deb *.rpm *.AppImage *.appimage