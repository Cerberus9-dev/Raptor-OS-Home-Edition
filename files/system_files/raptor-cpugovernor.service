[Unit]
Description=Raptor OS CPU policy compatibility check
# CPU governor, boost, EPP and frequency limits are owned by
# power-profiles-daemon. Writing cpufreq sysfs nodes here would race KDE
# Powerdevil and make the battery profile slider unreliable.
After=power-profiles-daemon.service
Wants=power-profiles-daemon.service

[Service]
Type=oneshot
ExecStart=/usr/bin/powerprofilesctl get
RemainAfterExit=yes
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
