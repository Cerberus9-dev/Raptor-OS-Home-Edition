import { Button, ListView, Slider } from "std-widgets.slint";

export struct TrackData {
    id: string,
    title: string,
    artist: string,
    album: string,
    duration: string,
}

export struct PlaylistData {
    id: string,
    name: string,
}

export component MainWindow inherits Window {
    title: "Raptor Music";
    width: 900px;
    height: 620px;
    background: #0f141c;

    in-out property <[TrackData]> track_list: [];
    in-out property <[TrackData]> queue_list: [];
    in-out property <[PlaylistData]> playlist_list: [];
    in-out property <string> new_playlist_name: "";
    in-out property <int> selected_playlist_index: -1;
    in-out property <int> selected_track_index: -1;
    in-out property <string> search_query: "";
    in-out property <int> selected_queue_index: -1;
    in-out property <int> playing_queue_index: -1;
    in-out property <string> current_track_title: "Not Playing";
    in-out property <string> current_track_artist: "";
    in-out property <string> progress_label: "0:00 / 0:00";
    in-out property <float> duration_secs: 0;
    in-out property <float> playback_position_secs: 0;
    in-out property <bool> is_seeking: false;
    in-out property <string> player_state_label: "Idle";

    callback scan_directory_clicked();
    callback track_selected(int);
    callback search_changed(string);
    callback queue_selected(int);
    callback playlist_selected(int);
    callback create_playlist_clicked();
    callback add_to_playlist_clicked();
    callback load_playlist_clicked();
    callback remove_queue_clicked();
    callback add_to_queue_clicked();
    callback play_clicked();
    callback seek_clicked(float);
    callback previous_clicked();
    callback next_clicked();
    callback stop_clicked();

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        // ── Header ───────────────────────────────────────────────────────
        HorizontalLayout {
            spacing: 12px;
            Text {
                text: "Raptor Music";
                font-size: 24px;
                font-weight: 700;
                color: #5ab0ff;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: root.player_state_label;
                color: #9aa7b8;
                font-size: 13px;
                vertical-alignment: center;
            }
        }

        // ── Library + queue ──────────────────────────────────────────────
        HorizontalLayout {
            spacing: 16px;
            vertical-stretch: 1;

            VerticalLayout {
                horizontal-stretch: 3;
                vertical-stretch: 1;
                spacing: 6px;

                Text { text: "Library"; font-weight: 700; color: #c7d2e0; font-size: 15px; }

                Rectangle {
                    height: 34px;
                    background: #202a38;
                    border-radius: 4px;
                    TextInput {
                        x: 9px;
                        y: 0px;
                        width: parent.width - 18px;
                        height: parent.height;
                        text <=> root.search_query;
                        color: #e6edf6;
                        font-size: 13px;
                        vertical-alignment: center;
                        edited => { root.search_changed(self.text); }
                    }
                }

                ListView {
                    vertical-stretch: 1;

                    for t[index] in root.track_list : Rectangle {
                        height: 46px;
                        border-radius: 4px;
                        background: index == root.selected_track_index ? #24405f : transparent;

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 10px;

                            Text {
                                text: t.title;
                                color: #e6edf6;
                                font-size: 14px;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }
                            Text {
                                text: t.artist;
                                color: #9aa7b8;
                                font-size: 12px;
                                vertical-alignment: center;
                                width: 130px;
                                overflow: elide;
                            }
                            Text {
                                text: t.album;
                                color: #9aa7b8;
                                font-size: 12px;
                                vertical-alignment: center;
                                width: 130px;
                                overflow: elide;
                            }
                            Text {
                                text: t.duration;
                                color: #9aa7b8;
                                font-size: 12px;
                                vertical-alignment: center;
                                width: 56px;
                            }
                        }

                        TouchArea {
                            clicked => { root.track_selected(index); }
                        }
                    }
                }

                Button {
                    text: "Add Selected to Queue";
                    clicked => { root.add_to_queue_clicked(); }
                }
            }

            VerticalLayout {
                horizontal-stretch: 2;
                vertical-stretch: 1;
                spacing: 6px;

                Text { text: "Playlists"; font-weight: 700; color: #c7d2e0; font-size: 15px; }
                HorizontalLayout {
                    height: 32px;
                    spacing: 6px;
                    Rectangle {
                        background: #202a38;
                        border-radius: 4px;
                        horizontal-stretch: 1;
                        TextInput {
                            x: 6px;
                            y: 0px;
                            width: parent.width - 12px;
                            height: parent.height;
                            text <=> root.new_playlist_name;
                            color: #e6edf6;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                    }
                    Button { text: "Create"; clicked => { root.create_playlist_clicked(); } }
                }
                ListView {
                    height: 104px;
                    for p[index] in root.playlist_list : Rectangle {
                        height: 32px;
                        border-radius: 4px;
                        background: index == root.selected_playlist_index ? #24405f : transparent;
                        Text {
                            text: p.name;
                            color: #e6edf6;
                            vertical-alignment: center;
                            x: 8px;
                            width: parent.width - 16px;
                            overflow: elide;
                        }
                        TouchArea { clicked => { root.playlist_selected(index); } }
                    }
                }
                HorizontalLayout {
                    spacing: 6px;
                    Button { text: "Add Track"; clicked => { root.add_to_playlist_clicked(); } }
                    Button { text: "Load Queue"; clicked => { root.load_playlist_clicked(); } }
                }

                Text { text: "Playback Queue"; font-weight: 700; color: #c7d2e0; font-size: 15px; }

                ListView {
                    vertical-stretch: 1;

                    for t[index] in root.queue_list : Rectangle {
                        height: 46px;
                        border-radius: 4px;
                        background: index == root.playing_queue_index ? #1f4d3a : (index == root.selected_queue_index ? #24405f : transparent);

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 10px;

                            Text {
                                text: t.title;
                                color: #e6edf6;
                                font-size: 14px;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }
                            Text {
                                text: t.artist;
                                color: #9aa7b8;
                                font-size: 12px;
                                vertical-alignment: center;
                                width: 110px;
                                overflow: elide;
                            }
                            Text {
                                text: t.duration;
                                color: #9aa7b8;
                                font-size: 12px;
                                vertical-alignment: center;
                                width: 56px;
                            }
                        }

                        TouchArea {
                            clicked => { root.queue_selected(index); }
                        }
                    }
                }
                Button { text: "Remove Selected"; clicked => { root.remove_queue_clicked(); } }
            }
        }

        // ── Now playing + controls ───────────────────────────────────────
        Rectangle {
            background: #1a2230;
            border-radius: 8px;
            height: 92px;

            HorizontalLayout {
                padding: 12px;
                spacing: 12px;

                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 2px;
                    Text { text: root.current_track_title; font-size: 16px; font-weight: 700; color: #ffffff; }
                    Text { text: root.current_track_artist; font-size: 13px; color: #cccccc; }
                    Text { text: root.progress_label; font-size: 12px; color: #5ab0ff; }
                    Slider {
                        minimum: 0;
                        maximum: root.duration_secs;
                        value <=> root.playback_position_secs;
                        enabled: root.duration_secs > 0;
                        horizontal-stretch: 1;
                        changed(value) => { root.is_seeking = true; }
                    }
                    Button {
                        text: "Seek";
                        enabled: root.duration_secs > 0;
                        clicked => {
                            root.is_seeking = false;
                            root.seek_clicked(root.playback_position_secs);
                        }
                    }
                }

                Button { text: "Scan Folder"; clicked => { root.scan_directory_clicked(); } }
                Button { text: "Previous"; clicked => { root.previous_clicked(); } }
                Button { text: "Play / Pause"; clicked => { root.play_clicked(); } }
                Button { text: "Next"; clicked => { root.next_clicked(); } }
                Button { text: "Stop"; clicked => { root.stop_clicked(); } }
            }
        }
    }
}
