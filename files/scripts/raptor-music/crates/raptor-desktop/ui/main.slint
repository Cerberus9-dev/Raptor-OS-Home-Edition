import { Button, LineEdit, ListView, Slider } from "std-widgets.slint";

export struct TrackData {
    id: string,
    title: string,
    artist: string,
    album: string,
    duration: string,
}

export struct PlaylistData {
    id: string,
    name: string,
}

export struct ImportedProfileData {
    id: string,
    name: string,
    subtitle: string,
    avatar: image,
}

export component MainWindow inherits Window {
    title: "Raptor Music";
    preferred-width: 1180px;
    preferred-height: 760px;
    min-width: 860px;
    min-height: 600px;
    background: #101510;

    in-out property <[TrackData]> track_list: [];
    in-out property <[TrackData]> online_track_list: [];
    in-out property <[TrackData]> online_artist_list: [];
    in-out property <[TrackData]> online_collection_list: [];
    in-out property <string> online_search_status: "Search artist names, song titles or keywords";
    in-out property <string> online_sort_method: "relevant";
    in-out property <int> selected_online_track_index: -1;
    in-out property <[TrackData]> queue_list: [];
    in-out property <[PlaylistData]> playlist_list: [];
    in-out property <[ImportedProfileData]> imported_profile_list: [];
    in-out property <string> imported_profile_detail: "Select an imported profile to inspect its playlists, saved tracks, artists and listening history.";
    in-out property <string> new_playlist_name: "";
    in-out property <int> selected_playlist_index: -1;
    in-out property <int> selected_track_index: -1;
    in-out property <string> search_query: "";
    in-out property <int> selected_queue_index: -1;
    in-out property <int> playing_queue_index: -1;
    in-out property <int> menu_track_index: -1;
    in-out property <string> menu_track_source: "";
    in-out property <string> current_track_title: "Choose something to play";
    in-out property <string> current_track_artist: "Your music, your library";
    in-out property <string> progress_label: "0:00 / 0:00";
    in-out property <float> duration_secs: 0;
    in-out property <float> playback_position_secs: 0;
    in-out property <bool> is_seeking: false;
    in-out property <string> player_state_label: "Ready";
    in-out property <string> active_view: "discover";
    in-out property <string> artist_profile_name: "";
    in-out property <string> artist_profile_handle: "";
    in-out property <string> artist_profile_bio: "";
    in-out property <string> artist_profile_stats: "";
    in-out property <string> artist_profile_status: "";
    in-out property <string> profile_import_status: "Import a profile export to preview what can be transferred";
    in-out property <bool> discord_presence_enabled: false;
    in-out property <string> discord_client_id: "";
    in-out property <string> discord_details_template: "{title}";
    in-out property <string> discord_state_template: "by {artist}";
    in-out property <string> discord_custom_phrase: "Jamming out to";
    in-out property <string> discord_presence_status: "Discord Rich Presence is off";
    in-out property <string> provider_connection_status: "No music-service accounts connected";

    callback scan_directory_clicked();
    callback import_profile_clicked();
    callback confirm_profile_import_clicked();
    callback imported_profile_selected(int);
    callback refresh_imported_profiles_clicked();
    callback track_selected(int);
    callback online_track_selected(int);
    callback artist_selected(int);
    callback collection_selected(int);
    callback search_changed(string);
    callback queue_selected(int);
    callback playlist_selected(int);
    callback create_playlist_clicked();
    callback add_to_playlist_clicked();
    callback load_playlist_clicked();
    callback remove_queue_clicked();
    callback add_to_queue_clicked();
    callback track_menu_action(int, string, string, int);
    callback skip_backward_clicked();
    callback skip_forward_clicked();
    callback save_discord_presence_clicked();
    callback connect_spotify_clicked();
    callback connect_tidal_clicked();
    callback connect_youtube_clicked();
    callback disconnect_spotify_clicked();
    callback disconnect_tidal_clicked();
    callback disconnect_youtube_clicked();
    callback play_clicked();
    callback seek_clicked(float);
    callback previous_clicked();
    callback next_clicked();
    callback stop_clicked();

    VerticalLayout {
        spacing: 0px;

        // Top application bar
        Rectangle {
            background: #1b241b;
            height: 66px;
            HorizontalLayout {
                padding-left: 24px;
                padding-right: 24px;
                spacing: 14px;
                Text {
                    text: "RAPTOR";
                    color: #b4d66d;
                    font-size: 13px;
                    font-weight: 800;
                    vertical-alignment: center;
                }
                Text {
                    text: "MUSIC";
                    color: #f2f5ec;
                    font-size: 21px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                Text {
                    text: root.player_state_label;
                    color: #b0bdb0;
                    font-size: 12px;
                    vertical-alignment: center;
                }
                Button {
                    text: "Import folder";
                    clicked => { root.scan_directory_clicked(); }
                }
            }
        }

        // Main navigation, collection and queue
        HorizontalLayout {
            spacing: 0px;
            vertical-stretch: 1;

            // Navigation and playlists
            Rectangle {
                width: 210px;
                background: #151d17;
                VerticalLayout {
                    padding: 18px;
                    spacing: 12px;
                    Text {
                        text: "BROWSE";
                        color: #879487;
                        font-size: 11px;
                        font-weight: 700;
                    }
                    Rectangle {
                        height: 36px;
                        border-radius: 6px;
                        background: root.active_view == "discover" ? #34482a : transparent;
                        Text {
                            text: "Discover";
                            color: root.active_view == "discover" ? #d4ed9c : #c1cbc0;
                            x: 10px;
                            vertical-alignment: center;
                            font-size: 14px;
                            font-weight: root.active_view == "discover" ? 700 : 500;
                        }
                        TouchArea {
                            clicked => {
                                root.active_view = "discover";
                                root.search_changed(root.search_query);
                            }
                        }
                    }
                    Rectangle {
                        height: 36px;
                        border-radius: 6px;
                        background: #263329;
                        Text {
                            text: "Import profile…";
                            color: #d4ed9c;
                            x: 10px;
                            vertical-alignment: center;
                            font-size: 14px;
                            font-weight: 600;
                        }
                        TouchArea {
                            clicked => { root.import_profile_clicked(); }
                        }
                    }
                    Text {
                        text: root.profile_import_status;
                        color: #9eae9d;
                        font-size: 10px;
                        wrap: word-wrap;
                    }
                    Rectangle {
                        height: 34px;
                        border-radius: 6px;
                        background: #35472d;
                        Text {
                            text: "Confirm profile import";
                            color: #d4ed9c;
                            x: 10px;
                            vertical-alignment: center;
                            font-size: 12px;
                            font-weight: 600;
                        }
                        TouchArea {
                            clicked => { root.confirm_profile_import_clicked(); }
                        }
                    }
                    Rectangle {
                        height: 36px;
                        border-radius: 6px;
                        background: root.active_view == "imported-profiles" ? #34482a : transparent;
                        Text {
                            text: "Imported profiles";
                            color: root.active_view == "imported-profiles" ? #d4ed9c : #c1cbc0;
                            x: 10px;
                            vertical-alignment: center;
                            font-size: 14px;
                            font-weight: root.active_view == "imported-profiles" ? 700 : 500;
                        }
                        TouchArea {
                            clicked => {
                                root.active_view = "imported-profiles";
                                root.refresh_imported_profiles_clicked();
                            }
                        }
                    }
                    Rectangle {
                        height: 36px;
                        border-radius: 6px;
                        background: root.active_view == "settings" ? #34482a : transparent;
                        Text {
                            text: "Settings";
                            color: root.active_view == "settings" ? #d4ed9c : #c1cbc0;
                            x: 10px;
                            vertical-alignment: center;
                            font-size: 14px;
                            font-weight: root.active_view == "settings" ? 700 : 500;
                        }
                        TouchArea { clicked => { root.active_view = "settings"; } }
                    }
                    Rectangle {
                        height: 36px;
                        border-radius: 6px;
                        background: root.active_view == "library" ? #34482a : transparent;
                        Text {
                            text: "Local library";
                            color: root.active_view == "library" ? #d4ed9c : #c1cbc0;
                            x: 10px;
                            vertical-alignment: center;
                            font-size: 14px;
                            font-weight: root.active_view == "library" ? 700 : 500;
                        }
                        TouchArea {
                            clicked => {
                                root.active_view = "library";
                                root.search_changed(root.search_query);
                            }
                        }
                    }
                    Rectangle { height: 1px; background: #354237; }
                    HorizontalLayout {
                        Text {
                            text: "PLAYLISTS";
                            color: #879487;
                            font-size: 11px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Text {
                            text: "♫";
                            color: #b4d66d;
                            font-size: 18px;
                        }
                    }
                    Text {
                        text: "Playlists";
                        color: #879487;
                        font-size: 11px;
                        font-weight: 700;
                    }
                    HorizontalLayout {
                        height: 34px;
                        spacing: 5px;
                        Rectangle {
                            background: #273229;
                            border-radius: 5px;
                            horizontal-stretch: 1;
                            TextInput {
                                x: 8px;
                                y: 0px;
                                width: parent.width - 16px;
                                height: parent.height;
                                text <=> root.new_playlist_name;
                                color: #edf2e7;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                        }
                        Button {
                            text: "+";
                            clicked => { root.create_playlist_clicked(); }
                        }
                    }
                    ListView {
                        vertical-stretch: 1;
                        for p[index] in root.playlist_list : Rectangle {
                            height: 38px;
                            border-radius: 5px;
                            background: index == root.selected_playlist_index ? #34482a : transparent;
                            Text {
                                text: p.name;
                                color: index == root.selected_playlist_index ? #d4ed9c : #c1cbc0;
                                x: 9px;
                                width: parent.width - 18px;
                                vertical-alignment: center;
                                overflow: elide;
                                font-size: 13px;
                            }
                            TouchArea { clicked => { root.playlist_selected(index); } }
                        }
                    }
                    Button {
                        text: "Add selected track";
                        enabled: root.selected_playlist_index >= 0 && (root.selected_track_index >= 0 || root.selected_online_track_index >= 0);
                        clicked => { root.add_to_playlist_clicked(); }
                    }
                    Button {
                        text: "Play selected playlist";
                        enabled: root.selected_playlist_index >= 0;
                        clicked => { root.load_playlist_clicked(); }
                    }
                }
            }

            // Main library surface
            Rectangle {
                background: #1a231c;
                horizontal-stretch: 1;
                VerticalLayout {
                    padding: 24px;
                    spacing: 16px;

                    Text {
                        text: root.active_view == "discover" ? "Find your next favorite." : (root.active_view == "artist" ? root.artist_profile_name : "Your music, organized.");
                        color: #f2f5ec;
                        font-size: 29px;
                        font-weight: 700;
                    }
                    Text {
                        text: root.active_view == "discover"
                            ? "Explore tracks and independent artists from across the online catalog."
                            : (root.active_view == "artist" ? "Artist profile and available tracks." : "Your local files stay separate from online discovery.");
                        color: #b0bdb0;
                        font-size: 13px;
                    }

                    VerticalLayout {
                        visible: root.active_view == "imported-profiles";
                        spacing: 12px;
                        HorizontalLayout {
                            Text { text: "Connected profiles"; color: #f2f5ec; font-size: 19px; font-weight: 700; }
                            Rectangle { horizontal-stretch: 1; }
                            Button { text: "Refresh"; clicked => { root.refresh_imported_profiles_clicked(); } }
                        }
                        Text {
                            text: "Imported accounts stay separate from your local files and playlists.";
                            color: #879487;
                            font-size: 11px;
                        }
                        ListView {
                            height: 190px;
                            for p[index] in root.imported_profile_list : Rectangle {
                                height: 54px;
                                border-radius: 7px;
                                background: #202b21;
                                HorizontalLayout {
                                    padding-left: 12px; padding-right: 12px; spacing: 10px;
                                    Image {
                                        source: p.avatar;
                                        width: 42px;
                                        height: 42px;
                                    }
                                    VerticalLayout {
                                        horizontal-stretch: 1; spacing: 2px;
                                        Text { text: p.name; color: #edf5fb; font-size: 13px; font-weight: 600; vertical-alignment: center; overflow: elide; }
                                        Text { text: p.subtitle; color: #9eae9d; font-size: 10px; vertical-alignment: center; overflow: elide; }
                                    }
                                    Text { text: "View"; color: #b4d66d; font-size: 11px; vertical-alignment: center; }
                                }
                                TouchArea { clicked => { root.imported_profile_selected(index); } }
                            }
                        }
                        Text {
                            text: root.imported_profile_detail;
                            color: #c1cbc0;
                            font-size: 12px;
                            wrap: word-wrap;
                            vertical-stretch: 1;
                        }
                    }

                    VerticalLayout {
                        visible: root.active_view == "settings";
                        spacing: 12px;
                        Text { text: "Music providers"; color: #f2f5ec; font-size: 21px; font-weight: 700; }
                        Text {
                            text: "Raptor Music connects accounts through provider sign-in, never by collecting service passwords. Account linking, library import, catalog search and playback are separate capabilities and depend on each provider's API permissions.";
                            color: #a5b2a3; font-size: 12px; wrap: word-wrap;
                        }
                        Text { text: "Apple Music catalog setup"; color: #d4ed9c; font-size: 13px; font-weight: 700; }
                        Text {
                            text: "App developers can provide RAPTOR_APPLE_MUSIC_DEVELOPER_TOKEN at launch. RAPTOR_APPLE_MUSIC_STOREFRONT is optional and defaults to us. Never place the MusicKit private key in this app or repository. Apple Music account sign-in still needs its separate MusicKit user-authorization implementation.";
                            color: #879487; font-size: 11px; wrap: word-wrap;
                        }
                        Text { text: "Connect music accounts"; color: #d4ed9c; font-size: 14px; font-weight: 700; }
                        Text {
                            text: "Spotify sign-in uses user-approved OAuth scopes for account and library metadata import. Spotify tracks remain provider references; this does not stream Spotify audio inside the combined player.";
                            color: #879487; font-size: 11px; wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Button { text: "Connect Spotify"; clicked => { root.connect_spotify_clicked(); } }
                            Button { text: "Disconnect"; clicked => { root.disconnect_spotify_clicked(); } }
                        }
                        Text {
                            text: "TIDAL sign-in uses its documented OAuth 2.1 + PKCE flow. The app imports the account profile and playlist metadata when the registered client has the user.read and playlists.read scopes. Playlist track-item import and playback are separate capabilities.";
                            color: #879487; font-size: 11px; wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Button { text: "Connect TIDAL"; clicked => { root.connect_tidal_clicked(); } }
                            Button { text: "Disconnect"; clicked => { root.disconnect_tidal_clicked(); } }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Button { text: "Connect YouTube account"; clicked => { root.connect_youtube_clicked(); } }
                            Button { text: "Disconnect"; clicked => { root.disconnect_youtube_clicked(); } }
                        }
                        Text { text: root.provider_connection_status; color: #b4d66d; font-size: 11px; wrap: word-wrap; }
                        Rectangle { height: 1px; background: #354236; }
                        Text { text: "Discord Rich Presence"; color: #f2f5ec; font-size: 21px; font-weight: 700; }
                        Text {
                            text: "Show what you're listening to in Discord and compatible clients. Raptor Music connects to a local Discord RPC socket; it does not send your music history to a Raptor server.";
                            color: #a5b2a3; font-size: 12px; wrap: word-wrap;
                        }
                        Text { text: "Application Client ID"; color: #d4ed9c; font-size: 12px; font-weight: 700; }
                        LineEdit {
                            placeholder-text: "Paste your Discord application's Client ID";
                            text <=> root.discord_client_id;
                            font-size: 13px;
                        }
                        Text { text: "Personal phrase · shown before the track title"; color: #d4ed9c; font-size: 12px; font-weight: 700; }
                        LineEdit {
                            placeholder-text: "Jamming out to";
                            text <=> root.discord_custom_phrase;
                            font-size: 13px;
                        }
                        Text { text: "Track line · {title} and {artist} fill in automatically"; color: #d4ed9c; font-size: 12px; font-weight: 700; }
                        LineEdit {
                            placeholder-text: "{title}";
                            text <=> root.discord_details_template;
                            font-size: 13px;
                        }
                        Text { text: "Artist line · use {title} and {artist}"; color: #d4ed9c; font-size: 12px; font-weight: 700; }
                        LineEdit {
                            placeholder-text: "by {artist}";
                            text <=> root.discord_state_template;
                            font-size: 13px;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Button {
                                text: root.discord_presence_enabled ? "Turn Rich Presence off" : "Turn Rich Presence on";
                                clicked => { root.discord_presence_enabled = !root.discord_presence_enabled; root.save_discord_presence_clicked(); }
                            }
                            Button { text: "Save settings"; clicked => { root.save_discord_presence_clicked(); } }
                        }
                        Text { text: root.discord_presence_status; color: #a5b2a3; font-size: 11px; wrap: word-wrap; }
                    }

                    Rectangle {
                        visible: root.active_view == "discover" || root.active_view == "library";
                        height: 44px;
                        background: #273229;
                        border-radius: 8px;
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 8px;
                            Text {
                                text: "⌕";
                                color: #b4d66d;
                                font-size: 20px;
                                vertical-alignment: center;
                            }
                            LineEdit {
                                placeholder-text: root.active_view == "discover"
                                    ? "Search artists, songs and keywords"
                                    : "Search your local library";
                                text <=> root.search_query;
                                font-size: 14px;
                                horizontal-stretch: 1;
                                edited(text) => { root.search_changed(text); }
                            }
                        }
                    }

                    Text {
                        visible: root.active_view != "artist";
                        text: root.active_view == "discover"
                            ? "Search online catalog results here; your local files remain in Your Library."
                            : "Search matches across local titles, artists and album names.";
                        color: #879487;
                        font-size: 11px;
                    }

                    VerticalLayout {
                        visible: root.active_view == "artist";
                        spacing: 10px;
                        Button {
                            text: "Back to Discover";
                            clicked => {
                                root.active_view = "discover";
                                root.search_changed(root.search_query);
                            }
                        }
                        Text {
                            text: root.artist_profile_name;
                            color: #f2f5ec;
                            font-size: 28px;
                            font-weight: 700;
                        }
                        Text {
                            text: root.artist_profile_handle;
                            color: #b4d66d;
                            font-size: 13px;
                        }
                        Text {
                            text: root.artist_profile_stats;
                            color: #879487;
                            font-size: 11px;
                        }
                        Text {
                            text: root.artist_profile_bio;
                            color: #c1cbc0;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            Text {
                                text: "Popular tracks";
                                color: #f2f5ec;
                                font-size: 18px;
                                font-weight: 700;
                            }
                            Rectangle { horizontal-stretch: 1; }
                            Text {
                                text: root.artist_profile_status;
                                color: #879487;
                                font-size: 11px;
                                vertical-alignment: center;
                            }
                        }
                        ListView {
                            visible: root.online_track_list.length > 0;
                            vertical-stretch: 1;
                            for t[index] in root.online_track_list : Rectangle {
                                height: 48px;
                                border-radius: 6px;
                                background: index == root.selected_online_track_index ? #34482a : #202b21;
                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    spacing: 10px;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 1px;
                                        Text { text: t.title; color: #edf5fb; font-size: 12px; vertical-alignment: center; overflow: elide; }
                                        Text { text: t.artist; color: #a5b2a3; font-size: 10px; vertical-alignment: center; overflow: elide; }
                                        TouchArea { clicked => { root.online_track_selected(index); root.play_clicked(); } }
                                    }
                                    Text { text: t.album; color: #a5b2a3; width: 110px; font-size: 10px; vertical-alignment: center; overflow: elide; }
                                    Text { text: t.duration; color: #a5b2a3; width: 48px; font-size: 10px; vertical-alignment: center; }
                                    Button { text: "⋮"; clicked => { root.menu_track_index = index; root.menu_track_source = "online"; } }
                                }
                            }
                        }
                        Button {
                            text: "Add selected track to queue";
                            enabled: root.selected_online_track_index >= 0;
                            clicked => { root.add_to_queue_clicked(); }
                        }
                    }

                    HorizontalLayout {
                        visible: root.active_view == "library";
                        Text {
                            text: "Local library";
                            color: #f2f5ec;
                            font-size: 18px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Text {
                            text: "Local files · title, artist, album";
                            color: #879487;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                    }

                    // Column headings
                    HorizontalLayout {
                        visible: root.active_view == "library";
                        padding-left: 12px;
                        padding-right: 12px;
                        height: 28px;
                        Text { text: "#"; color: #879487; width: 28px; font-size: 11px; }
                        Text { text: "TITLE"; color: #879487; horizontal-stretch: 1; font-size: 11px; }
                        Text { text: "ALBUM"; color: #879487; width: 150px; font-size: 11px; }
                        Text { text: "TIME"; color: #879487; width: 52px; font-size: 11px; }
                    }

                    Text {
                        visible: root.active_view == "library" && root.track_list.length == 0;
                        text: "No matching local tracks. Import a folder or try a different search.";
                        color: #879487;
                        font-size: 13px;
                    }
                    ListView {
                        visible: root.active_view == "library" && root.track_list.length > 0;
                        vertical-stretch: 1;
                        for t[index] in root.track_list : Rectangle {
                            height: 52px;
                            border-radius: 6px;
                            background: index == root.selected_track_index ? #34482a : #202b21;
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 10px;
                                Text {
                                    text: "{index + 1}";
                                    color: #899789;
                                    width: 28px;
                                    vertical-alignment: center;
                                    font-size: 12px;
                                }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 1px;
                                    Text {
                                        text: t.title;
                                        color: #edf5fb;
                                        font-size: 13px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: t.artist;
                                        color: #a5b2a3;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    TouchArea { clicked => { root.track_selected(index); root.play_clicked(); } }
                                }
                                Text {
                                    text: t.album;
                                    color: #a5b2a3;
                                    width: 150px;
                                    vertical-alignment: center;
                                    font-size: 11px;
                                    overflow: elide;
                                }
                                Text {
                                    text: t.duration;
                                    color: #a5b2a3;
                                    width: 52px;
                                    vertical-alignment: center;
                                    font-size: 11px;
                                }
                                Button { text: "⋮"; clicked => { root.menu_track_index = index; root.menu_track_source = "local"; } }
                            }
                        }
                    }

                    HorizontalLayout {
                        visible: root.active_view == "discover";
                        Text {
                            text: "Online discovery";
                            color: #f2f5ec;
                            font-size: 18px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Text {
                            text: root.online_search_status;
                            color: #879487;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                    }

                    HorizontalLayout {
                        visible: root.active_view == "discover";
                        Text { text: "Sort"; color: #879487; font-size: 11px; vertical-alignment: center; }
                        Button { text: "Relevant"; clicked => { root.online_sort_method = "relevant"; root.search_changed(root.search_query); } }
                        Button { text: "Popular"; clicked => { root.online_sort_method = "popular"; root.search_changed(root.search_query); } }
                        Button { text: "Recent"; clicked => { root.online_sort_method = "recent"; root.search_changed(root.search_query); } }
                        Button { text: "Independent"; clicked => { root.online_sort_method = "independent"; root.search_changed(root.search_query); } }
                    }
                    Text { visible: root.active_view == "discover"; text: "Artists"; color: #f2f5ec; font-size: 18px; font-weight: 700; }
                    ListView {
                        visible: root.active_view == "discover" && root.online_artist_list.length > 0;
                        height: 104px;
                        for a[index] in root.online_artist_list : Rectangle {
                            height: 48px; border-radius: 6px; background: #202b21;
                            HorizontalLayout {
                                padding-left: 12px; padding-right: 12px; spacing: 10px;
                                Rectangle { width: 32px; height: 32px; border-radius: 16px; background: #34412c;
                                    Text { text: "♪"; color: #c5d99a; font-size: 18px; horizontal-alignment: center; vertical-alignment: center; }
                                }
                                VerticalLayout { horizontal-stretch: 1; spacing: 1px;
                                    Text { text: a.title; color: #edf5fb; font-size: 12px; vertical-alignment: center; overflow: elide; }
                                    Text { text: a.artist; color: #a5b2a3; font-size: 10px; vertical-alignment: center; overflow: elide; }
                                }
                                Text { text: "Open profile"; color: #b4d66d; font-size: 10px; vertical-alignment: center; }
                            }
                            TouchArea { clicked => { root.artist_selected(index); } }
                        }
                    }
                    Text { visible: root.active_view == "discover" && root.online_collection_list.length > 0; text: "Albums & playlists"; color: #f2f5ec; font-size: 18px; font-weight: 700; }
                    ListView {
                        visible: root.active_view == "discover" && root.online_collection_list.length > 0;
                        height: 150px;
                        for c[index] in root.online_collection_list : Rectangle {
                            height: 48px; border-radius: 6px; background: #202b21;
                            HorizontalLayout {
                                padding-left: 12px; padding-right: 12px; spacing: 10px;
                                Rectangle { width: 32px; height: 32px; border-radius: 5px; background: #34412c;
                                    Text { text: c.album == "Album" ? "▣" : "≡"; color: #c5d99a; font-size: 16px; horizontal-alignment: center; vertical-alignment: center; }
                                }
                                VerticalLayout { horizontal-stretch: 1; spacing: 1px;
                                    Text { text: c.title; color: #edf5fb; font-size: 12px; vertical-alignment: center; overflow: elide; }
                                    Text { text: c.artist; color: #a5b2a3; font-size: 10px; vertical-alignment: center; overflow: elide; }
                                }
                                Text { text: "Open"; color: #b4d66d; font-size: 10px; vertical-alignment: center; }
                            }
                            TouchArea { clicked => { root.collection_selected(index); } }
                        }
                    }
                    Text { visible: root.active_view == "discover"; text: "Tracks"; color: #f2f5ec; font-size: 18px; font-weight: 700; }
                    ListView {
                        visible: root.active_view == "discover" && root.online_track_list.length > 0;
                        vertical-stretch: 1;
                        for t[index] in root.online_track_list : Rectangle {
                            height: 48px;
                            border-radius: 6px;
                            background: index == root.selected_online_track_index ? #34482a : #202b21;
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 10px;
                                Rectangle {
                                    width: 34px;
                                    height: 34px;
                                    border-radius: 5px;
                                    background: #34412c;
                                    Text {
                                        text: "♫";
                                        color: #c5d99a;
                                        font-size: 19px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 1px;
                                    Text {
                                        text: t.title;
                                        color: #edf5fb;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: t.artist;
                                        color: #a5b2a3;
                                        font-size: 10px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    TouchArea { clicked => { root.online_track_selected(index); root.play_clicked(); } }
                                }
                                Text {
                                    text: t.album;
                                    color: #a5b2a3;
                                    width: 110px;
                                    vertical-alignment: center;
                                    font-size: 10px;
                                    overflow: elide;
                                }
                                Text {
                                    text: t.duration;
                                    color: #a5b2a3;
                                    width: 48px;
                                    vertical-alignment: center;
                                    font-size: 10px;
                                }
                                Button { text: "⋮"; clicked => { root.menu_track_index = index; root.menu_track_source = "online"; } }
                            }
                        }
                    }

                    HorizontalLayout {
                        visible: root.active_view == "discover";
                        spacing: 8px;
                        Button {
                            text: "Add selected to queue";
                            clicked => { root.add_to_queue_clicked(); }
                        }
                        Button {
                            text: "Import folder";
                            clicked => { root.scan_directory_clicked(); }
                        }
                    }
                }
            }

            // Queue sidebar
            Rectangle {
                width: 238px;
                background: #151d17;
                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;
                    Text {
                        text: "Up next";
                        color: #f2f5ec;
                        font-size: 18px;
                        font-weight: 700;
                    }
                    Text {
                        text: "Your queue";
                        color: #879487;
                        font-size: 11px;
                    }
                    ListView {
                        vertical-stretch: 1;
                        for t[index] in root.queue_list : Rectangle {
                            height: 52px;
                            border-radius: 5px;
                            background: index == root.playing_queue_index ? #31472b : (index == root.selected_queue_index ? #34482a : transparent);
                            VerticalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 2px;
                                Text {
                                    text: t.title;
                                    color: #edf5fb;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                Text {
                                    text: t.artist;
                                    color: #a5b2a3;
                                    font-size: 10px;
                                    overflow: elide;
                                }
                            }
                            TouchArea { clicked => { root.queue_selected(index); } }
                        }
                    }
                    Text {
                        visible: root.queue_list.length == 0;
                        text: "Nothing queued";
                        color: #879487;
                        font-size: 11px;
                    }
                    Button {
                        text: "Remove from queue";
                        enabled: root.selected_queue_index >= 0;
                        clicked => { root.remove_queue_clicked(); }
                    }
                    VerticalLayout {
                        visible: root.menu_track_index >= 0;
                        spacing: 4px;
                        Rectangle { height: 1px; background: #354237; }
                        Text { text: "Song options"; color: #d4ed9c; font-size: 12px; font-weight: 700; }
                        Button {
                            text: "Add to queue";
                            clicked => {
                                root.track_menu_action(root.menu_track_index, root.menu_track_source, "queue", -1);
                                root.menu_track_index = -1;
                            }
                        }
                        Text { text: "Add to playlist"; color: #a5b2a3; font-size: 11px; }
                        for p[index] in root.playlist_list : Button {
                            text: p.name;
                            clicked => {
                                root.track_menu_action(root.menu_track_index, root.menu_track_source, "playlist", index);
                                root.menu_track_index = -1;
                            }
                        }
                        Button { text: "Close"; clicked => { root.menu_track_index = -1; } }
                    }
                }
            }
        }

        // Persistent player dock
        Rectangle {
            height: 116px;
            background: #202a20;
            HorizontalLayout {
                padding: 16px;
                spacing: 18px;

                Rectangle {
                    width: 68px;
                    height: 68px;
                    border-radius: 8px;
                    background: #35472d;
                    Text {
                        text: "♫";
                        color: #d4ed9c;
                        font-size: 36px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                VerticalLayout {
                    width: 230px;
                    spacing: 3px;
                    Text {
                        text: root.current_track_title;
                        color: #f2f5ec;
                        font-size: 14px;
                        font-weight: 700;
                        overflow: elide;
                    }
                    Text {
                        text: root.current_track_artist;
                        color: #b0bdb0;
                        font-size: 12px;
                        overflow: elide;
                    }
                    Text {
                        text: root.player_state_label;
                        color: #b4d66d;
                        font-size: 10px;
                    }
                }

                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 4px;
                    HorizontalLayout {
                        alignment: center;
                        spacing: 12px;
                        Button { text: "−15s"; enabled: root.duration_secs > 0; clicked => { root.skip_backward_clicked(); } }
                        Button { text: "Previous"; enabled: root.playing_queue_index > 0 || root.selected_queue_index > 0; clicked => { root.previous_clicked(); } }
                        Button { text: root.player_state_label == "Playing" ? "Pause" : "Play"; clicked => { root.play_clicked(); } }
                        Button { text: "Next"; enabled: root.queue_list.length > 1 && (root.playing_queue_index < root.queue_list.length - 1 || root.selected_queue_index < root.queue_list.length - 1); clicked => { root.next_clicked(); } }
                        Button { text: "+15s"; enabled: root.duration_secs > 0; clicked => { root.skip_forward_clicked(); } }
                        Button { text: "Stop"; enabled: root.player_state_label == "Playing" || root.player_state_label == "Paused" || root.player_state_label == "Loading"; clicked => { root.stop_clicked(); } }
                    }
                    Slider {
                        minimum: 0;
                        maximum: root.duration_secs;
                        value <=> root.playback_position_secs;
                        enabled: root.duration_secs > 0;
                        horizontal-stretch: 1;
                        changed(value) => { root.is_seeking = true; }
                    }
                    HorizontalLayout {
                        Text { text: root.progress_label; color: #a5b2a3; font-size: 10px; }
                        Rectangle { horizontal-stretch: 1; }
                        Button {
                            text: "Seek";
                            enabled: root.duration_secs > 0;
                            clicked => {
                                root.is_seeking = false;
                                root.seek_clicked(root.playback_position_secs);
                            }
                        }
                    }
                }
            }
        }
    }
}
