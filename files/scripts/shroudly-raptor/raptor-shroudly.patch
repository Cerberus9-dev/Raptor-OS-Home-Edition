diff --git a/core/src/raw_linux.c b/core/src/raw_linux.c
index a5d773d..888681c 100644
--- a/core/src/raw_linux.c
+++ b/core/src/raw_linux.c
@@ -193,7 +193,16 @@ static void iptables_udp_install(void) {
   int ok = 1;
   if (g_quic_block) ok = iptables_udp_rule("-I", UDPR_QUIC) == 0;
   if (ok && g_udp_fake) ok = iptables_udp_rule("-I", UDPR_DISCOVERY) == 0 && iptables_udp_rule("-I", UDPR_STUN) == 0;
-  if (ok) { g_udp_match = 1; return; }
+  if (ok) {
+    g_udp_match = 1;
+    /* Raptor: game UDP (Roblox and the like) is not STUN-shaped, so no
+     * payload test matches it and it would never reach the loop. Append the
+     * ports-alone rule after the tested ones, so a datagram no test matches
+     * still gets queued and the loop can send decoys ahead of it. Appended,
+     * not inserted: the tested rules must stay first. */
+    if (g_udp_fake) iptables_udp_rule("-A", UDPR_PORTS);
+    return;
+  }
   for (int k = UDPR_QUIC; k <= UDPR_STUN; k++) iptables_udp_drain(k);
   iptables_udp_rule("-I", UDPR_PORTS);
 }
@@ -314,7 +323,18 @@ static int install_rule(void) {
         SHROUDLY_FWMARK, g_queue_num);
       ok = ok && nft(rule) == 0;
     }
-    if (ok) g_udp_match = 1;
+    if (ok) {
+      g_udp_match = 1;
+      /* Raptor: as with iptables above, queue the rest of the UDP on these
+       * ports too (games), after the tested rules, so a datagram no test
+       * matches still reaches the loop. */
+      if (g_udp_fake) {
+        snprintf(rule, sizeof(rule),
+          "add rule ip shroudly out udp dport { %s } meta mark and 0x%x == 0 queue num %d bypass",
+          g_udp_nft, SHROUDLY_FWMARK, g_queue_num);
+        nft(rule);
+      }
+    }
     else {
       snprintf(rule, sizeof(rule),
         "add rule ip shroudly out udp dport { %s } meta mark and 0x%x == 0 queue num %d bypass",
@@ -722,6 +742,17 @@ static uint32_t judge(const nfq_packet *q) {
       else if (udp_flow_note(&g_flows, ip->saddr, udp->source, ip->daddr, udp->dest, (uint32_t)now_ms()))
         send_udp_decoys(ip, udp, plen);
     }
+    /* (3) Raptor: other UDP on the queued ports (games: Roblox and the like).
+     * No payload test identifies a game flow, so without this the datagram
+     * would be accepted with nothing sent ahead of it, and a censor that
+     * fingerprints the first datagrams of a flow would see the game as it
+     * is. Same treatment as voice: decoys ahead of the first datagrams of
+     * the flow, never toward a local address; the real datagram is always
+     * accepted unchanged. */
+    else if (g_udp_fake && plen > 0 && !local) {
+      if (udp_flow_note(&g_flows, ip->saddr, udp->source, ip->daddr, udp->dest, (uint32_t)now_ms()))
+        send_udp_decoys(ip, udp, plen);
+    }
     return NF_ACCEPT;
   }
 
